<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ResetPasswordFragment">


    <TextView
        android:id="@+id/tituloLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="156dp"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="156dp"
        android:text="Recuperar Senha"
        android:textColor="@color/destaque"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="26dp"
        android:text="Código de Verificação"
        android:textColor="@color/destaque"
        app:layout_constraintBottom_toTopOf="@+id/edtCode"
        app:layout_constraintStart_toStartOf="@+id/tituloLogin"
        app:layout_constraintTop_toBottomOf="@+id/tituloLogin" />

    <EditText
        android:id="@+id/edtCode"
        android:layout_width="260dp"
        android:layout_height="44dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="26dp"
        android:ems="10"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/novasenha"
        app:layout_constraintTop_toBottomOf="@+id/txtCode"
        tools:layout_editor_absoluteX="55dp"
        app:layout_constraintStart_toStartOf="@+id/tituloLogin" />

    <TextView
        android:id="@+id/novasenha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="26dp"
        android:text="Nova senha"
        android:textColor="@color/destaque"
        app:layout_constraintBottom_toTopOf="@+id/editText2"
        app:layout_constraintStart_toStartOf="@+id/tituloLogin"
        app:layout_constraintTop_toBottomOf="@+id/edtCode" />

    <EditText
        android:id="@+id/editText2"
        android:layout_width="260dp"
        android:layout_height="44dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="26dp"
        android:ems="10"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/NovaSenha"
        app:layout_constraintStart_toStartOf="@+id/tituloLogin"
        app:layout_constraintTop_toBottomOf="@+id/novasenha" />

    <TextView
        android:id="@+id/NovaSenha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="26dp"
        android:text="Confirmar senha"
        android:textColor="@color/destaque"
        app:layout_constraintBottom_toTopOf="@+id/editText"
        app:layout_constraintStart_toStartOf="@+id/tituloLogin"
        app:layout_constraintTop_toBottomOf="@+id/editText2" />

    <EditText
        android:id="@+id/editText"
        android:layout_width="260dp"
        android:layout_height="44dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="26dp"
        android:ems="10"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/tituloLogin"
        app:layout_constraintTop_toBottomOf="@+id/NovaSenha" />

    <TextView
        android:id="@+id/txtTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reenviar em: 60s"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@+id/edtCode"
        app:layout_constraintEnd_toEndOf="@+id/edtCode" />

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        android:layout_marginTop="52dp"
        android:backgroundTint="@color/destaque"
        android:text="Voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editText" />

    <Button
        android:id="@+id/btnConfirmar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="58dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="80dp"
        android:backgroundTint="@color/destaque"
        android:text="Confirmar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.238"
        app:layout_constraintStart_toEndOf="@+id/btnVoltar"
        app:layout_constraintTop_toBottomOf="@+id/editText" />


</androidx.constraintlayout.widget.ConstraintLayout>