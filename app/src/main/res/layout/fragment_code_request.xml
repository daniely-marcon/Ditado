<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Titulo -->
    <TextView
        android:id="@+id/txtCODE_Request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="72dp"
        android:text="Recuperar Senha"
        android:textColor="@color/destaque"
        android:background="@color/white"
        android:textSize="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

   <!-- Email-->

    <TextView
        android:id="@+id/txtCampo_Email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="124dp"
        android:text="Email"
        android:textColor="@color/destaque"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtCODE_Request" />

    <!-- Inserir Email  -->

    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="272dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="80dp"
        android:inputType="text"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtCampo_Email" />

    <!-- Confirmar pedido de código  -->

    <Button
        android:id="@+id/btnEnviar_CODE"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="50dp"
        android:backgroundTint="@color/destaque"
        android:text="Enviar Código"
        android:textColor="@color/white"
        app:layout_constraintStart_toEndOf="@+id/btnVoltar_CODE"
        app:layout_constraintTop_toBottomOf="@+id/edtEmail" />

    <!-- B2 Voltar pagina -->
    <Button
        android:id="@+id/btnVoltar_CODE"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="50dp"
        android:backgroundTint="@color/destaque"
        android:text="Voltar"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtEmail" />


</androidx.constraintlayout.widget.ConstraintLayout>